{
  "name": "curevie-backend",
  "version": "1.0.0",
  "description": "Curevie home medical care platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore 'uploads/' --ignore 'logs/' server.js",
    "db:init": "node config/initDb.js",
    "db:migrate": "node config/runMigrations.js",
    "test": "node --test",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --test tests/cases.integration.test.js",
    "db:seed:dev": "node config/seeds/dev_seed.js",
    "db:seed:catalog": "node config/seeds/catalog_seed.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0",
    "puppeteer": "^24.39.1",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
