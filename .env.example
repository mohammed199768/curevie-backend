# On the server: NODE_ENV=production (docker-compose also forces it). Production turns on secure
# cookies, strict CORS (only the curevie.net sites + CORS_EXTRA_ORIGINS) and the real rate limits.
PORT=5000
NODE_ENV=development

# PostgreSQL: prefer DATABASE_URL; otherwise DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are used.
# With docker-compose leave DATABASE_URL empty and set DB_USER/DB_PASSWORD/DB_NAME (they also create
# the postgres container's database); DB_HOST is set to the "postgres" service by compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/curevie
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=curevie

# Redis (rate limits, token blacklist, socket.io fan-out). Required in production.
REDIS_URL=redis://localhost:6379

# Two different long random strings, e.g. `openssl rand -base64 48`. The app refuses to start without them.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=5m

# First admin account. Used by `npm run db:init` only when the database has no admin yet.
# Password: 12+ chars with upper case, lower case and a digit. Remove it after the first run.
INITIAL_ADMIN_NAME=System Admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Extra browser origins allowed by CORS/socket.io (exact URLs, comma separated), e.g. a Vercel preview.
# Leave empty on the server unless a site runs on another domain; never put localhost here in production.
CORS_EXTRA_ORIGINS=

# Bunny CDN. Public images (avatars, catalog) are served from BUNNY_CDN_URL.
# Private medical files are stored under "private/" and only streamed by the API after an access check.
# Without these, private files are stored on local disk (uploads/private) and image uploads are disabled.
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_CDN_URL=
BUNNY_STORAGE_REGION=de

# Optional Telegram alerts for 500 errors / slow queries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLOW_QUERY_THRESHOLD_MS=2000

